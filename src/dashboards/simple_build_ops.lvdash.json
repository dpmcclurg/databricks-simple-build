{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT count(*) FROM adjustment_files WHERE parse_error IS NULL)     AS files_loaded,\n",
        "  (SELECT count(*) FROM adjustment_files WHERE parse_error IS NOT NULL) AS files_failed,\n",
        "  (SELECT count(*) FROM adjustment_reconciliation WHERE status = 'OK')  AS recon_ok,\n",
        "  (SELECT count(*) FROM adjustment_reconciliation WHERE status <> 'OK') AS recon_breaks\n"
      ]
    },
    {
      "name": "ds_files",
      "displayName": "Files",
      "queryLines": [
        "SELECT source_file_name, source_modified_at, row_count, parse_error,\n",
        "       CASE WHEN parse_error IS NULL THEN 'Loaded' ELSE 'Failed' END AS file_status\n",
        "FROM adjustment_files\n",
        "ORDER BY source_modified_at DESC\n"
      ]
    },
    {
      "name": "ds_rows",
      "displayName": "Rows per month",
      "queryLines": [
        "SELECT CAST(date_trunc('MONTH', revenue_date) AS DATE) AS month, revenue_type_code,\n",
        "       COUNT(*) AS days, SUM(revenue_amount) AS revenue\n",
        "FROM revenue_adjustment_daily\n",
        "GROUP BY ALL\n",
        "ORDER BY ALL\n"
      ]
    },
    {
      "name": "ds_recon",
      "displayName": "Reconciliation",
      "queryLines": [
        "SELECT year_month, customer_id, revenue_type_code, source_file_name, file_total, spread_total, difference, status\n",
        "FROM adjustment_reconciliation\n",
        "ORDER BY year_month, customer_id\n"
      ]
    },
    {
      "name": "ds_legacy",
      "displayName": "Legacy compare",
      "queryLines": [
        "SELECT month_start, ours, legacy, only_ours, only_legacy, matched, status\n",
        "FROM legacy_compare\n",
        "ORDER BY month_start\n"
      ]
    }
  ],
